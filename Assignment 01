#include <stdio.h>
#include <string.h>

int main()
{
    char email[50], password[20];

    printf("Enter your email: ");
    scanf("%s", email);

    printf("Enter your password: ");
    scanf("%s", password);

    if (strcmp(email, "student@gmail.com") == 0 &&
        strcmp(password, "12345") == 0)
    {
        printf("Login successful!");
    }
    else
    {
        printf("Invalid email or password.");
    }

    return 0;
}
