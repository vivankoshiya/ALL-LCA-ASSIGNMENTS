#include <stdio.h>
#include <time.h>

int main() { 
    int year, month, day; 
    int days[12] = {31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31};

    char *months[12] = {
        "January", "February", "March",
        "April", "May", "June",
        "July", "August", "September",
        "October", "November", "December"
    };

    struct tm date;

    printf("Enter year: ");
    scanf("%d", &year);

    // Check for leap year
    if(year % 400 == 0 || (year % 4 == 0 && year % 100 != 0)) {
        days[1] = 29;
    }

    for(month = 0; month < 12; month++) {
        date.tm_year = year - 1900;
        date.tm_mon = month;
        date.tm_mday = 1;
        date.tm_hour = 12;
        date.tm_min = 0;
        date.tm_sec = 0;
        date.tm_isdst = -1;

        // Populate tm_wday
        mktime(&date);

        printf("\n\n     %s %d\n", months[month], year);
        printf("Sun Mon Tue Wed Thu Fri Sat\n");

        int space_count = date.tm_wday;

        // Print initial spaces for the first week row
        for(day = 0; day < space_count; day++) {
            printf("    ");
        }

        // Print all days of the month
        for(day = 1; day <= days[month]; day++) {
            printf("%3d ", day);
            space_count++;

            // Wrap to next line every 7 columns
            if(space_count % 7 == 0) {
                printf("\n");
            }
        }

        printf("\n");
    }

    return 0;
}
