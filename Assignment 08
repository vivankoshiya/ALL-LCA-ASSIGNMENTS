#include <stdio.h>

int main() { 
    int a, b, temp; 
    int p, q;

    printf("Enter the first number: ");
    scanf("%d", &a);

    printf("Enter the second number: ");
    scanf("%d", &b);

    p = &a;
    q = &b;

    printf("\nBefore Swapping:\n");
    printf("First number = %d\n", a);
    printf("Second number = %d\n", b);

    temp = *p;
    *p = *q;
    *q = temp;

    printf("\nAfter Swapping:\n");
    printf("First number = %d\n", a);
    printf("Second number = %d\n", b);

    return 0;
}
